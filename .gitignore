# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
dist-electron/
dist-smoke/
release/
*.tsbuildinfo

# Generated smoke-test entry point
desktop/.smoke-entry.ts

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local env / secrets
.env
.env.*
!.env.example
*.local

# Google Drive backup OAuth client. Contains a live client_secret — the
# committed template is google-drive-oauth.example.json.
desktop/resources/google-drive-oauth.json

# Code-signing material (CSC_LINK / CSC_KEY_PASSWORD point at these).
# Never commit a certificate or its password.
*.pfx
*.p12
*.pem
*.key
*.keystore
*.jks

# Vendor-only record of issued license keys (npm run genkey) — plaintext keys.
desktop/scripts/issued-keys.jsonl

# Local databases
*.db
*.db-shm
*.db-wal

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
nul
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Export verification harness build output
desktop/scripts/.export-verify.mjs
