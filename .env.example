# POS-APP — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is the only
# one that is committed, so never put a real value in it.
#
# Every variable here is OPTIONAL. With none of them set the app runs
# fully offline: it opens its local SQLite database, sells, prints and
# backs up to a local folder. The variables below only switch on the
# features that need an outside service.


# ─── Vendor cloud (membership / licensing only) ──────────────────────────
# Base URL of the vendor licensing API. Used solely by the membership
# activation round trip in electron/services/subscription.ts — shop data
# never travels over it.
#
# Leave EMPTY for an offline install. Every call then returns null and the
# app carries on; licence keys still validate against their own checksum
# with no internet at all.
POS_CLOUD_URL=


# ─── Google Drive backup (optional, off-site backup) ─────────────────────
# Only needed if shops will back up to Google Drive.
#
# Preferred setup: copy desktop/resources/google-drive-oauth.example.json
# to desktop/resources/google-drive-oauth.json and fill it in. That file is
# gitignored and is read at runtime, so no credential is compiled into the
# shipped bundle.
#
# These two variables are an alternative to that file (the file wins if
# both are present). Create a Desktop-app OAuth client in Google Cloud
# Console → APIs & Services → Credentials.
POS_GOOGLE_DRIVE_CLIENT_ID=
POS_GOOGLE_DRIVE_CLIENT_SECRET=


# ─── Code signing (release builds only) ──────────────────────────────────
# Unsigned Windows installers trip SmartScreen and some antivirus products
# block them outright. Set these only on the release machine — never commit
# a certificate or its password. *.pfx/*.p12/*.pem are gitignored.
#
# CSC_LINK          path to, or base64 of, a .pfx  (OV, file-based)
# CSC_KEY_PASSWORD  its password
#
# Certificates issued since June 2023 require a hardware token or cloud
# HSM; those need "certificateSubjectName" or a custom sign hook in
# desktop/electron-builder.json5 instead of these two variables.
CSC_LINK=
CSC_KEY_PASSWORD=


# ─── Test harness (set by npm scripts — do not set by hand) ──────────────
# POS_SMOKE=1        electron/main.ts runs the acceptance suite and exits
#                    (npm run test:smoke)
# POS_PRINT_SMOKE=1  runs the print verification pass
#                    (npm run verify:print)
